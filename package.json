{
  "name": "repocrumb",
  "version": "0.1.2",
  "description": "The Crumb handoff protocol for coding agents. LOAD -> VERIFY -> WORK -> SAVE: a short last_crumb.md in your repo, anchored to a commit so you always know how much of it still applies, letting any AI coding agent pick up where the last one stopped across sessions, tools and providers.",
  "keywords": [
    "ai",
    "agent",
    "crumb",
    "handoff",
    "protocol",
    "context",
    "claude",
    "claude-code",
    "cursor",
    "codex",
    "llm",
    "developer-tools"
  ],
  "license": "MIT",
  "bin": {
    "repocrumb": "bin/repocrumb.js"
  },
  "main": "src/install.js",
  "files": [
    "bin",
    "src",
    "templates",
    "SPEC.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/smoke.js && node conformance/run.js --cmd \"node conformance/reference.js\"",
    "conformance": "node conformance/run.js --cmd \"node conformance/reference.js\" --verbose"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1hemantbhatt/repocrumb.git"
  },
  "bugs": {
    "url": "https://github.com/1hemantbhatt/repocrumb/issues"
  },
  "homepage": "https://github.com/1hemantbhatt/repocrumb#readme",
  "exports": {
    ".": "./src/install.js",
    "./crumb": "./src/lib/crumb.js",
    "./package.json": "./package.json"
  }
}
